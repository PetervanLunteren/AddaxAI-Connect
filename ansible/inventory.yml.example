---
# Copy to inventory.yml and fill in your own servers. inventory.yml is
# gitignored, so your machines never end up in this repo.
#
#   cp ansible/inventory.yml.example ansible/inventory.yml
#
# One entry per server. The name on the left is how you address it:
#
#   ansible-playbook -i ansible/inventory.yml ansible/playbook.yml --limit myserver
#
# Per-server settings and passwords go in host_vars/<name>.yml, one file each.
# Settings shared by all of them go in group_vars/all/main.yml. Ansible finds
# both folders next to whichever inventory file you pass with -i, so the three
# can also live in a private repo of their own. See ansible/README.md.

all:
  vars:
    # The user ansible connects as. Ubuntu VMs usually start with root, and the
    # playbook creates the unprivileged app user itself.
    ansible_user: root
    ansible_ssh_private_key_file: ~/.ssh/id_rsa
    ansible_python_interpreter: /usr/bin/python3

  children:
    # Group your live servers so you can target them together when you mean to.
    # With one server this group is optional, keep it anyway, it costs nothing
    # and the day you add a second one it is already there.
    prod:
      hosts:
        myserver:
          ansible_host: 192.0.2.10
        # another:
        #   ansible_host: 192.0.2.11

  # Servers outside any group. A test box you restore backups onto fits here.
  # Do not give a group the same name as a host in it, ansible warns and
  # --limit becomes ambiguous.
  # hosts:
  #   mytestserver:
  #     ansible_host: 192.0.2.20
