# Rotation for the log files the cron jobs append to. Generated by Ansible.
#
# Weekly, 13 kept, so about 90 days of history. copytruncate because the
# writers are cron jobs that reopen the file on every run anyway, and it
# keeps the file's owner and mode as they are. Runs as root without `su`:
# the folder is not group or world writable, and security-check.log in it is
# written by root's cron, which the app user could not truncate. Container
# logs are not here: docker-compose.yml caps those by size.

{{ app_directory | default('/opt/addaxai-connect') }}/logs/*.log {
    weekly
    rotate 13
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

/var/log/certbot-renew.log {
    weekly
    rotate 13
    compress
    delaycompress
    missingok
    notifempty
}
